{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overmyroof",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "keep_vars": true,
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://overmyroof.barisyilmazcontact.workers.dev"
  },
  "kv_namespaces": [
    {
      "binding": "OVERMYROOF_KV",
      "id": "bfa35790575a408eb7721b15bbb29001"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*",
      "!/og/*",
      "!/favicon.ico",
      "!/favicon.svg",
      "!/favicon-32x32.png",
      "!/apple-touch-icon.png",
      "!/icon-192.png"
    ]
  }
}
