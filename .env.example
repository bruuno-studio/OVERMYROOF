# Leave unset to auto-detect (live when AIRNODEHUB_WALLET_PRIVATE_KEY is set, demo otherwise).
# Explicitly set "true" to force zero-cost sample mode or "false" to require live AirnodeHub calls.
DEMO_MODE=true

# Public origin used for canonical metadata & OG card URLs (set to your live domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side burner wallet private key (Base Sepolia aUSD x402 settlements). NEVER commit real keys.
# AIRNODEHUB_WALLET_PRIVATE_KEY=

# Optional external OpenAI-compatible TTS API key (falls back to browser Web Speech API if unset)
# TTS_API_KEY=

# Optional Upstash Redis REST fallback (if not using Cloudflare Workers KV binding `OVERMYROOF_KV`)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
